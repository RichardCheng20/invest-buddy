{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/invest-buddy/schemas/research.schema.json",
  "title": "AI 研究",
  "description": "一条研究结果。入库前按 $defs.research 逐条校验。",
  "$defs": {
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "date",
        "rating",
        "conclusion",
        "bull_points",
        "bear_points",
        "news_sentiment",
        "fundamentals",
        "technical_view",
        "risk_review",
        "sources",
        "model_note"
      ],
      "properties": {
        "ticker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "pattern": "^[A-Za-z][A-Za-z0-9.-]{0,14}$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "rating": {
          "type": "string",
          "enum": ["买入", "增持", "持有", "减持", "卖出"]
        },
        "conclusion": { "type": "string", "minLength": 1, "maxLength": 500 },
        "bull_points": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "bear_points": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "news_sentiment": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "fundamentals": {
          "type": "object",
          "maxProperties": 40,
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "technical_view": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "risk_review": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "sources": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "url": { "type": "string", "pattern": "^https?://[^\\s]+$" }
            }
          }
        },
        "model_note": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
