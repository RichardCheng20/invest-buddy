# 复制成 .env 后填入。不要提交 .env。这里没有任何真实密钥。

# --- GitHub Actions：AI 研究（OpenAI 兼容接口）---
# 正式名字是下面四项。留空的地址和模型名会用 config/research.yaml 里的默认值。
# 旧配置里的 DEEPSEEK_API_KEY 只在 LLM_API_KEY 为空时当作同一把钥匙，新配置不要用它。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_DEEP=deepseek-v4-pro
# 可选。设为 anthropic 时走 Anthropic 官方接口，钥匙也可只放 ANTHROPIC_API_KEY。
# LLM_PROVIDER=anthropic
# 可选。没有就跳过宏观序列。
FRED_API_KEY=
# SEC 要求带联系方式，例如：Example example@example.com
SEC_EDGAR_USER_AGENT=

# --- GitHub Actions：邮件 ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 多个收件人用英文逗号分隔
REPORT_TO=

# --- Cloudflare Worker ---
# wrangler.toml 里的 GH_REPO 也要改成同一个仓库，不能留 YOUR_GITHUB_USER
GH_REPO=YOUR_GITHUB_USER/invest-buddy
GH_BRANCH=main
# 三个 Worker secrets。用 npx wrangler secret put 写入，不要写进 Git。
GH_WATCHLIST_TOKEN=
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=
